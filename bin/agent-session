#!/usr/bin/env php
<?php

declare(strict_types=1);

use voku\AgentSession\Cli;

/**
 * @param list<string> $arguments
 * @return list<string>
 */
$withDefaultRoot = static function (array $arguments): array {
    foreach ($arguments as $argument) {
        if ($argument === '--root' || str_starts_with($argument, '--root=')) {
            return $arguments;
        }
    }

    $projectRoot = getcwd();
    if ($projectRoot === false || $projectRoot === '') {
        fwrite(STDERR, "Cannot determine project root for voku/agent-session.\n");
        exit(1);
    }

    $arguments[] = '--root';
    $arguments[] = rtrim(str_replace('\\', '/', $projectRoot), '/') . '/.agent-loop/sessions';

    return $arguments;
};

$argv = $withDefaultRoot($argv);

spl_autoload_register(static function (string $class): void {
    $prefix = 'voku\\AgentSession\\';
    if (!str_starts_with($class, $prefix)) {
        return;
    }

    $path = __DIR__ . '/../src/' . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';
    if (is_file($path)) {
        require $path;
    }
});

if (class_exists(Cli::class)) {
    exit((new Cli())->run($argv));
}

// The outer autoloader comes first on purpose. When this package is installed as a dependency its
// own vendor/ directory is normally absent, but a path repository, a mirrored checkout or a stale
// local install can leave one behind - and preferring it silently loads that copy's dependencies
// instead of the project's. The failure mode is a method or property that "does not exist" while the
// installed version plainly has it.
$autoloadCandidates = [
    __DIR__ . '/../../../autoload.php',
    __DIR__ . '/../vendor/autoload.php',
    getcwd() . '/vendor/autoload.php',
];

foreach ($autoloadCandidates as $autoloadCandidate) {
    if (is_file($autoloadCandidate)) {
        require $autoloadCandidate;
        exit((new Cli())->run($argv));
    }
}

fwrite(STDERR, "Cannot find Composer autoload file for voku/agent-session.\n");
exit(1);
